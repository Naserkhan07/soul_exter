# Copy this file to ".env" and fill in the keys for the providers you use.
#
# ============= 100% FREE stack (recommended) =============
# The agent needs ONLY one free key — Groq — for both listening (STT) and
# reasoning (LLM). Speaking uses Microsoft Edge TTS, which needs NO key at all.
#   Groq free key: https://console.groq.com/keys
GROQ_API_KEY=

# ------- Optional free / paid alternatives -------
# Gemini free tier (https://aistudio.google.com/apikey) — can replace Groq LLM.
GEMINI_API_KEY=
# Only needed if you switch STT/LLM/TTS to paid OpenAI providers.
OPENAI_API_KEY=
# Only needed if you switch STT to Deepgram (has a free tier too).
DEEPGRAM_API_KEY=
# Only needed if you switch TTS to ElevenLabs.
ELEVENLABS_API_KEY=

# --- Speech-to-Speech (Qwen Omni on Kaggle) ---
# URL the Kaggle server prints (STS: https://.../sts). Changes each session.
# You can also set it in config under sts.qwen_kaggle.url
QWEN_URL=

# Phone bridge (only if you use the paid Twilio bridge — otherwise ignore)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
