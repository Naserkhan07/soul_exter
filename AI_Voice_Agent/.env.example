# Copy this file to ".env" and fill in the keys for the providers you use.
#
# ============= PRIMARY BRAIN (recommended): Qwen on a free Kaggle GPU =====
# No API key is needed for Qwen. Just start scripts/kaggle/qwen_omni_server.ipynb
# on Kaggle (GPU T4 x2), copy the tunnel URL it prints, and set it in
# config/config.yaml -> sts.qwen_kaggle.url  (or in QWEN_URL below).
QWEN_URL=

# ------- Optional fallbacks (NOT required with Qwen on Kaggle) -------
# Gemini free tier (https://aistudio.google.com/apikey) — optional LLM fallback.
GEMINI_API_KEY=
# Only needed if you switch STT/LLM/TTS to paid OpenAI providers.
OPENAI_API_KEY=
# Only needed if you switch STT to Deepgram (has a free tier too).
DEEPGRAM_API_KEY=
# Only needed if you switch TTS to ElevenLabs.
ELEVENLABS_API_KEY=

# Greeting voice uses Microsoft Edge TTS — no key needed.
#
# Phone bridge (only if you use the paid Twilio bridge — otherwise ignore)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
