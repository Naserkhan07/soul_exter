# Telegram (not needed when only using shorts-cli)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Keep this bot private.
ALLOWED_TELEGRAM_USER_IDS=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# YouTube OAuth
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
AUTO_UPLOAD=false

# Workflow
CLIP_DURATION_SECONDS=25
MAX_URLS_PER_COMMAND=5
WORK_DIR=work
DATABASE_PATH=work/jobs.db
KEEP_WORK_FILES=true

# This must be true. Only process videos you own or are licensed to reuse.
RIGHTS_ACKNOWLEDGED=false
