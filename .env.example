# Groq AI
GROQ_API_KEY=
# The 8B model has a much larger free daily token allowance than the 70B model.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Long transcripts are sampled across the timeline before planning to control token use.
GROQ_MAX_TRANSCRIPT_CHARS=8000
# Detailed metadata is generated one clip at a time; pacing avoids the free-tier TPM limit.
GROQ_METADATA_DELAY_SECONDS=30
YOUTUBE_DESCRIPTION_TARGET_CHARS=4200
INSTAGRAM_CAPTION_TARGET_CHARS=2000
INSTAGRAM_HASHTAGS_FILE=instagram_hashtags.txt

# Optional YouTube sign-in cookies when YouTube displays "confirm you're not a bot".
# Supported values include brave, chrome, edge, and firefox. Leave profile blank to use
# the most recently accessed browser profile. Cookies stay local and are never exported.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_BROWSER_PROFILE=
# Netscape-format export for Chrome on Windows when DPAPI decryption fails.
# When set, this takes precedence over browser extraction. Never commit/share this file.
YTDLP_COOKIE_FILE=

# Non-secret channel/account IDs are read from this local TOML file.
CHANNEL_CONFIG_FILE=channels.toml

# YouTube OAuth. Password-based upload is intentionally not supported.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY_STATUS=public
UPLOAD_YOUTUBE=true

# Instagram Graph API. Requires a Professional (Business or Creator) account.
# Keep this token here in .env, never in channels.toml or Git.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0
UPLOAD_INSTAGRAM=true

# Optional Instagram DM delivery. The destination account must first message the Professional
# sender account. Use its Instagram-scoped ID returned by `instagram-dm-chats`, not a username.
# The token must include instagram_business_manage_messages. If the publishing token already has
# that permission, INSTAGRAM_DM_ACCESS_TOKEN can be left blank to reuse INSTAGRAM_ACCESS_TOKEN.
SEND_INSTAGRAM_DM=false
INSTAGRAM_DM_SENDER_ID=
INSTAGRAM_DM_RECIPIENT_ID=
INSTAGRAM_DM_ACCESS_TOKEN=
INSTAGRAM_DM_DELAY_MIN_SECONDS=3
INSTAGRAM_DM_DELAY_MAX_SECONDS=4

# Local file queue. Put one authorized YouTube URL on each line in links.txt.
LINKS_FILE=links.txt
DOWNLOADED_LINKS_LOG=work/downloaded-links.log
LINKS_POLL_SECONDS=30

# Local workflow
CLIP_DURATION_SECONDS=30
# full_coverage splits the usable timeline into consecutive clips; ai_highlights selects only strong moments.
SHORTS_SELECTION_MODE=full_coverage
# 0 = automatic based on duration (with a platform-safety ceiling of 100); positive values set a cap.
MAX_SHORTS_PER_VIDEO=0
# Show the complete source without zooming/cropping; unused 9:16 space is solid black.
VIDEO_LAYOUT=fit_black
# Never enlarge low-resolution source pixels inside the 1080x1920 black canvas.
VIDEO_ALLOW_UPSCALE=false
# Lower CRF means higher quality/larger files. 18 is visually high quality.
VIDEO_CRF=18
VIDEO_PRESET=slow

# Optional remote Real-ESRGAN stage. Rotate any key ever shown in a screenshot/chat.
VIDEO_ENHANCER=none
APIMARKET_API_KEY=
APIMARKET_BASE_URL=https://prod.api.market/api/v1/magicapi/video-upscaler-high-resolution-api
APIMARKET_VERSION=c23768236472c41b7a121ee735c8073e29080c01b32907740cfada61bff75320
APIMARKET_MODEL=RealESRGAN_x4plus
APIMARKET_RESOLUTION=FHD
# 5 matches the selected trial policy; 0 would enhance every clip and consume one unit each.
APIMARKET_MAX_CLIPS=5
APIMARKET_TIMEOUT_SECONDS=1200
# API.market needs a direct HTTPS video URL, so clips are temporarily hosted here and deleted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# When either platform reaches its daily limit, finish local clips in an ordinary folder and open it.
ARCHIVE_ON_UPLOAD_LIMIT=true
ARCHIVE_DIR=work/pending_uploads
OPEN_UPLOAD_LIMIT_FOLDER=true

WORK_DIR=work
DATABASE_PATH=work/jobs.db
KEEP_WORK_FILES=true

# This must be true. Only process videos you own or are licensed to reuse.
RIGHTS_ACKNOWLEDGED=false
