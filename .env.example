# Runtime
AUTOMATON_MODE=live
DATABASE_PATH=data/automaton.db
# Product/agent work every 60 seconds. Values below 30 are clamped; faster
# cycles increase model/API load and do not guarantee revenue.
CYCLE_SECONDS=60
MAX_PRODUCTS_PER_AGENT=8
# Genesis cash is hard-coded to zero. Compute/hosting is externally sponsored and
# never deducted from revenue. This is the real-revenue milestone for replication.
REPLICATION_THRESHOLD_CENTS=1000000
MAX_AGENTS=5
MIN_REPLICATION_AGE_HOURS=24
PUBLIC_BASE_URL=http://localhost:8000

# Automatic INR checkout and bank settlement through PhonePe Payment Gateway.
# Obtain credentials from PhonePe Business after merchant onboarding/KYC.
CURRENCY=INR
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PHONEPE_EXPIRE_SECONDS=1200
PHONEPE_POLL_SECONDS=60

# OpenAI-compatible planner. The included Kaggle notebook provides this free.
# LLM_API_KEY is the random tunnel token printed by the notebook, not an OpenAI key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Optional autonomous distribution to ONE operator-approved workflow/channel.
# Compatible with a Make/Zapier/n8n webhook or your own receiver.
PUBLICATION_WEBHOOK_URL=
PUBLICATION_WEBHOOK_TOKEN=
PUBLICATION_INTERVAL_HOURS=24

# Public RSS/Atom/JSON job feeds that permit automated reading. Comma-separated.
# Do not use feeds or sites whose terms prohibit bots or scraping.
JOB_FEED_URLS=
# Permitted feeds are checked once per minute; values below 60 are clamped.
JOB_SCAN_INTERVAL_SECONDS=60
OPPORTUNITY_WEBHOOK_URL=

# Optional workflow that emails a private delivery link to a paid customer.
DELIVERY_WEBHOOK_URL=

# Protects opportunity details and manual administrative actions.
ADMIN_TOKEN=
SUPPORT_EMAIL=

# Bounded concurrent autonomous workstreams (resource-friendly; not busy loops)
MAX_CONCURRENT_AGENTS=3
STRATEGY_REVIEW_SECONDS=300
